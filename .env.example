# Copy to .env and set GEMINI_API_KEY. Google Search grounding requires a paid-tier key.
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_THINKING=low
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_ROUTER_THINKING=minimal
GEMINI_PERSONALITY_MODEL=gemini-3.5-flash-lite
GEMINI_PERSONALITY_THINKING=minimal
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
PRICE_FLASH_INPUT_PER_M=0.75
PRICE_FLASH_OUTPUT_PER_M=3.75
PRICE_LITE_INPUT_PER_M=0.30
PRICE_LITE_OUTPUT_PER_M=2.50
PRICE_EMBEDDING_PER_M=0.20
PRICE_SEARCH_PER_1K=14
MAX_MESSAGE_CHARS=2000
RAG_TOP_K=6
RAG_MAX_PAGES=80
RAG_MIN_SIMILARITY=0.62
MAX_TOOL_ITERATIONS=3
REQUEST_TOKEN_BUDGET=20000
LLM_TIMEOUT_SECONDS=30
EVAL_REPEATS=3
EVAL_MIN_ROUTING_ACCURACY=0.9
EVAL_MIN_CITATION_RATE=0.9
EVAL_MIN_REFUSAL_RATE=0.9
EVAL_MIN_ASSERTION_RATE=0.9
